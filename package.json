{
  "name": "oxford-viewer",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "electron": "^44.3.0",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "desktop:build": "node desktop/build.cjs",
    "desktop": "npm run desktop:build && electron dist/desktop",
    "desktop:test": "npm run desktop:build && electron dist/desktop --smoke-test",
    "desktop:package": "npm run desktop:build && electron-packager dist/desktop OxfordViewer --platform=win32 --arch=x64 --out=dist/packages --overwrite --asar",
    "desktop:check-live": "npm run desktop:build && electron dist/desktop --live-check"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "private": true
}
